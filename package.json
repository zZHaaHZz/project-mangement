{
  "name": "project-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5001",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "lint": "eslint",
    "json-server": "json-server --watch db.json --port 3001 --middlewares ./node_modules/json-server-auth",
    "dev:all": "concurrently \"npm run dev\" \"npm run json-server\""
  },
