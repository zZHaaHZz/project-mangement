    "antd": "^6.1.2",
    "dayjs": "^1.11.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "json-server": "^0.17.4",
    "json-server-auth": "^2.1.0",
    "tailwindcss": "^4",
    "vite": "^6.0.5"
  },
  "description": "Project Management System with React and React Router",
